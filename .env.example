# Used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Upload password. Either a plaintext password...
UPLOAD_PASSWORD=change-me

# ...or a bcrypt hash (takes precedence). Generate with: npm run hash-password
# UPLOAD_PASSWORD_HASH=$2b$10$...

# Set to "true" when behind HTTPS (Cloudflare). Cookie will be Secure-only.
COOKIE_SECURE=false

# Where SQLite DB + uploaded photos are stored. In Docker, mount a volume here.
DATA_DIR=data
